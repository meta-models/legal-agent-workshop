# Copy to .env. Never commit the populated file.
MODEL_API_KEY=
MODEL_API_BASE_URL=https://api.meta.ai/v1
MODEL_API_MODEL=muse-spark-1.3
SAM_MODEL=sam-3.1
# The case to work on: a folder with objective.md and documents/ (relative to this directory).
CASE_DIR=../cases/northbridge-v-caldera
# Verification layer for new runs: the checks in verification/, escalation, attorney sign-off (off | on).
VERIFICATION=off
# The MCP tool server's port. The agent starts the server on its own when it is not
# already running; set MCP_SERVER_URL to share one server instead.
MCP_PORT=8000
# MCP_SERVER_URL=http://127.0.0.1:8000/mcp
